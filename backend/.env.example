# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000
ENABLE_FAKE_PAY=false
PAYMENT_PROVIDER=mock
MOCK_GATEWAY_SECRET=mock_gateway_secret_key_32bytes_sample
MOCK_WEBHOOK_SECRET=mock_webhook_secret_key_32bytes_sample
MOCK_WEBHOOK_ENABLED=true

# Database & Cache
MONGO_URI=mongodb://127.0.0.1:27017/marketplace
REDIS_URL=redis://127.0.0.1:6379
ES_NODE=http://127.0.0.1:9200
ES_INDEX=products

# Authentication (JWT)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# Cookie Settings (lax / false for local, none / true for cross-origin HTTPS in production)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# File Storage (AWS S3 / MinIO S3-Compatible)
# For local MinIO:
AWS_REGION=us-east-1
AWS_BUCKET=marketplace-images
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000
# For Real AWS S3 in production:
# Leave S3_ENDPOINT empty, set real AWS_REGION, AWS_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# Razorpay (Route - Test Mode)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Seed Account
ADMIN_EMAIL=admin@marketplace.com
ADMIN_PASSWORD=Admin@123456
